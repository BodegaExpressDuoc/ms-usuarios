{
  "info": {
    "name": "ms-usuarios",
    "description": "Pruebas de la API de ms-usuarios. Ejecutar en orden (Collection Runner): se crea un usuario, se inicia sesión y el token JWT se guarda en la variable `token`, que la colección envía como Bearer en las rutas protegidas.\n\nRequiere el servicio en ejecución en {{baseUrl}}. Crea un usuario de prueba y lo elimina al final.\n\nUso local: `baseUrl` = http://localhost:8081 (o el puerto de tu .env). Uso a través del AWS API Gateway: `baseUrl` = URL del Gateway (el registro y el login son rutas públicas; el resto exige el token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Perez\",\n  \"email\": \"carlos.{{$timestamp}}@example.com\",\n  \"password\": \"Clave123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
              "const usuario = pm.response.json();",
              "pm.test('Devuelve el id generado', () => pm.expect(usuario.id).to.be.a('number'));",
              "pm.test('Incluye la cabecera Location', () => pm.response.to.have.header('Location'));",
              "pm.collectionVariables.set('usuarioId', usuario.id);",
              "pm.collectionVariables.set('usuarioEmail', usuario.email);",
              "pm.test('No devuelve la contraseña', () => pm.expect(usuario).to.not.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"Clave123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test('Devuelve un token JWT', () => pm.expect(token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('token', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Iniciar sesión con contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"incorrecta\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('Error en formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Listar usuarios sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Obtener usuario por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve el usuario creado', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('usuarioId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Actualizar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Gonzalez\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"Clave123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Actualiza el apellido', () => pm.expect(pm.response.json().apellido).to.eql('Gonzalez'));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Crear usuario con email repetido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Soto\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"Clave123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Error en formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));",
              "pm.test('Indica que el email ya existe', () => pm.expect(pm.response.json().detail).to.eql('El email ya está registrado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Crear usuario con datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"apellido\": \"Soto\",\n  \"email\": \"correo-invalido\",\n  \"password\": \"\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Error en formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));",
              "const errores = pm.response.json().errores;",
              "pm.test('Indica el error del nombre', () => pm.expect(errores).to.have.property('nombre'));",
              "pm.test('Indica el error del email', () => pm.expect(errores).to.have.property('email'));",
              "pm.test('Indica el error de la contraseña', () => pm.expect(errores).to.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Obtener usuario inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Error en formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Eliminar usuario",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Obtener usuario eliminado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Error en formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "usuarioEmail",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
